# Copy this file to .env and adjust only the values you need.
VOICECHESS_APP_HOST=127.0.0.1
VOICECHESS_APP_PORT=8000
VOICECHESS_STOCKFISH_PATH=stockfish
VOICECHESS_STOCKFISH_SKILL_LEVEL=5
VOICECHESS_ENGINE_SEARCH_DEPTH=8
# VOICECHESS_ENGINE_MOVE_TIME_MS=250
VOICECHESS_ENGINE_STARTUP_TIMEOUT_MS=5000
VOICECHESS_ENGINE_MOVE_TIMEOUT_MS=10000
VOICECHESS_PGN_EXPORT_DIR=exports
VOICECHESS_LOG_LEVEL=INFO
VOICECHESS_LOG_DESTINATION=logs/voicechess.jsonl

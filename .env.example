# Copy this file to .env and adjust only the values you need.
VOICECHESS_APP_HOST=127.0.0.1
VOICECHESS_APP_PORT=8000
VOICECHESS_STOCKFISH_PATH=stockfish
VOICECHESS_STOCKFISH_SKILL_LEVEL=5
VOICECHESS_ENGINE_SEARCH_DEPTH=8
# VOICECHESS_ENGINE_MOVE_TIME_MS=250
VOICECHESS_ENGINE_STARTUP_TIMEOUT_MS=5000
VOICECHESS_ENGINE_MOVE_TIMEOUT_MS=10000
# Set this to a local Piper executable and an existing ONNX voice model.
VOICECHESS_PIPER_PATH=piper
# VOICECHESS_PIPER_MODEL_PATH=voices/en_US-lessac-medium.onnx
# Keep the matching voices/en_US-lessac-medium.onnx.json alongside the model.
VOICECHESS_PIPER_STARTUP_TIMEOUT_MS=5000
VOICECHESS_PIPER_SYNTHESIS_TIMEOUT_MS=10000
# Applies to each process-termination and request-cleanup wait.
VOICECHESS_PIPER_SHUTDOWN_TIMEOUT_MS=1000
# Private synthesis files live under audio/voicechess; replay bytes stay in memory.
VOICECHESS_PIPER_AUDIO_DIR=audio
VOICECHESS_PIPER_OUTPUT_FORMAT=wav
VOICECHESS_PIPER_OUTPUT_CHANNELS=1
# Optional validation against the configured voice model's sample rate.
# VOICECHESS_PIPER_EXPECTED_SAMPLE_RATE_HZ=22050
VOICECHESS_PIPER_RETENTION_POLICY=latest_per_game
VOICECHESS_PGN_EXPORT_DIR=exports
VOICECHESS_LOG_LEVEL=INFO
VOICECHESS_LOG_DESTINATION=logs/voicechess.jsonl
